# Copy to /backend/Job-Engineer/.env on the server (never commit real secrets).

NODE_ENV=production
PORT=3011

DATABASE_URL=postgresql://jobos:YOUR_POSTGRES_PASSWORD@127.0.0.1:5433/jobos
REDIS_URL=redis://127.0.0.1:6380

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_WEB_URL=https://job-engineer-web.vercel.app
NEXT_PUBLIC_LANDING_URL=https://job-engineer-landing-7mxt.vercel.app

UPLOAD_DIR=/backend/Job-Engineer/uploads

AI_PROVIDER=custom
AI_API_KEY=
AI_BASE_URL=https://api.hcnsec.cn/v1
AI_DEFAULT_MODEL=auto
AI_MAX_CONCURRENCY=5
AI_MAX_TOKENS_RESUME_PARSER=4096
AI_MAX_TOKENS_COVER_LETTER=2048
AI_MAX_TOKENS_ATS_SCORER=4096
AI_MAX_TOKENS_JOB_ANALYZER=4096
AI_MAX_TOKENS_EMAIL_WRITER=2048

OPENROUTER_API_KEY=
OPENROUTER_RESUME_PARSER_MAX_TOKENS=128
OPENROUTER_RESUME_PARSER_MODEL=google/gemini-2.0-flash-001

ADMIN_EMAILS=
